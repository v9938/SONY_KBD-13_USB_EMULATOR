        .Z80
        ASEG
        ORG 4000H

ENASLT EQU 024H ; ENASLT
SNSMAT EQU 0141H ; SNSMAT
RSLREG EQU 0138H ; RSLREG
SCRMOD EQU 0FCAFH ; SCRMOD
EXPTBL EQU 0FCC1H ; EXPTBL
CAPST EQU 0FCABH ; CAPST
KANAST EQU 0FCACH ; KANAST
ROW_VALUES EQU 0C000H ; ROW_VALUES
LAST_VALUES EQU 0C00BH ; LAST_VALUES
FORCE_DRAW EQU 0C016H ; FORCE_DRAW
DISPLAY_MODE EQU 0C017H ; DISPLAY_MODE
LAST_DISPLAY_MODE EQU 0C018H ; LAST_DISPLAY_MODE
VAR_ROW EQU 0C020H ; VAR_ROW
VAR_MASK EQU 0C021H ; VAR_MASK
VAR_X EQU 0C022H ; VAR_X
VAR_Y EQU 0C023H ; VAR_Y
VAR_W EQU 0C024H ; VAR_W
VAR_H EQU 0C025H ; VAR_H
VAR_TX EQU 0C026H ; VAR_TX
VAR_TY EQU 0C027H ; VAR_TY
VAR_LEN EQU 0C028H ; VAR_LEN
VAR_LABEL EQU 0C029H ; VAR_LABEL
VAR_NEXT EQU 0C02BH ; VAR_NEXT
VAR_FILL EQU 0C02DH ; VAR_FILL
VAR_BORDER EQU 0C02EH ; VAR_BORDER
VAR_TEXT EQU 0C02FH ; VAR_TEXT
VAR_CURY EQU 0C030H ; VAR_CURY
VAR_ROWS_LEFT EQU 0C031H ; VAR_ROWS_LEFT
VAR_CHAR_X EQU 0C032H ; VAR_CHAR_X
VAR_PIX_X EQU 0C033H ; VAR_PIX_X
VAR_PIX_Y EQU 0C034H ; VAR_PIX_Y
VAR_FONT_PTR EQU 0C035H ; VAR_FONT_PTR
VAR_FONT_BITS EQU 0C037H ; VAR_FONT_BITS
VAR_FONT_ROWS EQU 0C038H ; VAR_FONT_ROWS
VAR_FONT_COLS EQU 0C039H ; VAR_FONT_COLS
VAR_LABEL_PTR EQU 0C03AH ; VAR_LABEL_PTR
VAR_LABEL_LEFT EQU 0C03CH ; VAR_LABEL_LEFT
VAR_STYLE EQU 0C03DH ; VAR_STYLE
VAR_LABEL_W EQU 0C03EH ; VAR_LABEL_W

; Cartridge header: AB, entry 4010H, no BASIC extensions.
        DB 041H,042H
        DW app_start
        DW 00H
        DW 00H
        DW 00H
        REPT 6
        DB 00H
        ENDM
app_start: ; app_start (4010H)
        LD SP,0F380H
        CALL map_cartridge_page2
        CALL init_screen7
        CALL init_palette
        CALL clear_screen7
        CALL draw_branding
        CALL init_last_rows
        CALL scan_rows
        CALL read_display_mode
        CALL copy_display_mode
        LD A,01H
        LD (FORCE_DRAW),A
        EI
main_loop: ; main_loop (4034H)
        CALL scan_rows
        CALL check_display_mode
        DI
        CALL update_keys
        EI
        CALL copy_rows
        HALT
        JP main_loop
map_cartridge_page2: ; map_cartridge_page2 (4046H)
        CALL RSLREG
        RRCA
        RRCA
        AND 03H
        LD C,A
        LD B,00H
        LD HL,EXPTBL
        ADD HL,BC
        LD A,(HL)
        AND 080H
        OR C
        JP P,page2_slot_ready
        LD C,A
        INC HL
        INC HL
        INC HL
        INC HL
        LD A,(HL)
        AND 0CH
        OR C
page2_slot_ready: ; page2_slot_ready (4064H)
        LD H,080H
        CALL ENASLT
        RET
init_last_rows: ; init_last_rows (406AH)
        LD HL,LAST_VALUES
        LD B,0BH
        XOR A
init_last_loop: ; init_last_loop (4070H)
        LD (HL),A
        INC HL
        DJNZ init_last_loop
        RET
scan_rows: ; scan_rows (4075H)
        LD HL,ROW_VALUES
        LD B,0BH
        XOR A
        LD C,A
scan_loop: ; scan_loop (407CH)
        LD A,C
        PUSH BC
        PUSH HL
        CALL SNSMAT
        POP HL
        POP BC
        LD (HL),A
        INC HL
        INC C
        DJNZ scan_loop
        RET
copy_rows: ; copy_rows (408AH)
        LD HL,ROW_VALUES
        LD DE,LAST_VALUES
        LD B,0BH
copy_rows_loop: ; copy_rows_loop (4092H)
        LD A,(HL)
        LD (DE),A
        INC HL
        INC DE
        DJNZ copy_rows_loop
        XOR A
        LD (FORCE_DRAW),A
        CALL copy_display_mode
        RET
read_display_mode: ; read_display_mode (40A0H)
        LD A,(KANAST)
        OR A
        JR Z,display_mode_caps
        LD A,(CAPST)
        OR A
        JR Z,display_mode_hiragana
        LD A,03H
        JR display_mode_store
display_mode_hiragana: ; display_mode_hiragana (40B0H)
        LD A,02H
        JR display_mode_store
display_mode_caps: ; display_mode_caps (40B4H)
        LD A,(CAPST)
        OR A
        JR Z,display_mode_lower
        LD A,01H
        JR display_mode_store
display_mode_lower: ; display_mode_lower (40BEH)
        XOR A
display_mode_store: ; display_mode_store (40BFH)
        LD (DISPLAY_MODE),A
        RET
check_display_mode: ; check_display_mode (40C3H)
        CALL read_display_mode
        LD B,A
        LD A,(LAST_DISPLAY_MODE)
        CP B
        RET Z
        LD A,01H
        LD (FORCE_DRAW),A
        RET
copy_display_mode: ; copy_display_mode (40D2H)
        LD A,(DISPLAY_MODE)
        LD (LAST_DISPLAY_MODE),A
        RET
update_keys: ; update_keys (40D9H)
        LD HL,key_entries
entry_loop: ; entry_loop (40DCH)
        LD A,(HL)
        CP 0FFH
        RET Z
        LD (VAR_ROW),A
        INC HL
        LD A,(HL)
        LD (VAR_MASK),A
        INC HL
        LD A,(HL)
        LD (VAR_STYLE),A
        INC HL
        LD A,(HL)
        LD (VAR_X),A
        INC HL
        LD A,(HL)
        LD (VAR_Y),A
        INC HL
        LD A,(HL)
        LD (VAR_W),A
        INC HL
        LD A,(HL)
        LD (VAR_H),A
        INC HL
        LD A,(HL)
        LD (VAR_TY),A
        INC HL
        LD A,(HL)
        LD (VAR_TX),A
        INC HL
        LD A,(HL)
        LD (VAR_LABEL_W),A
        INC HL
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC HL
        LD (VAR_NEXT),DE
        LD A,(DISPLAY_MODE)
        ADD A,A
        LD E,A
        LD D,00H
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD (VAR_LABEL),DE
        LD A,(VAR_ROW)
        LD E,A
        LD D,00H
        LD HL,ROW_VALUES
        ADD HL,DE
        LD A,(HL)
        LD B,A
        LD HL,LAST_VALUES
        ADD HL,DE
        LD A,(HL)
        XOR B
        LD C,A
        LD A,(FORCE_DRAW)
        OR A
        JR NZ,entry_force_draw
        LD A,(VAR_MASK)
        AND C
        JR Z,entry_skip
entry_force_draw: ; entry_force_draw (4147H)
        LD A,(VAR_MASK)
        OR A
        JR Z,entry_released
        AND B
        JR Z,entry_pressed
entry_released: ; entry_released (4150H)
        LD A,(VAR_STYLE)
        OR A
        JR NZ,entry_released_special
        LD A,077H
        LD (VAR_FILL),A
        JR entry_released_colors
entry_released_special: ; entry_released_special (415DH)
        LD A,044H
        LD (VAR_FILL),A
entry_released_colors: ; entry_released_colors (4162H)
        LD A,022H
        LD (VAR_BORDER),A
        LD A,011H
        LD (VAR_TEXT),A
        JR entry_draw
entry_pressed: ; entry_pressed (416EH)
        LD A,011H
        LD (VAR_FILL),A
        LD A,077H
        LD (VAR_BORDER),A
        LD A,077H
        LD (VAR_TEXT),A
entry_draw: ; entry_draw (417DH)
        CALL draw_key
entry_skip: ; entry_skip (4180H)
        LD HL,(VAR_NEXT)
        JP entry_loop
draw_key: ; draw_key (4186H)
        CALL draw_rect
        LD A,(VAR_TX)
        LD (VAR_X),A
        LD A,(VAR_LABEL_W)
        LD (VAR_W),A
        LD HL,(VAR_LABEL)
        LD (VAR_LABEL_PTR),HL
        LD A,(VAR_TY)
        LD (VAR_CURY),A
        LD A,08H
        LD (VAR_ROWS_LEFT),A
        CALL draw_bitmap_rows
        RET
draw_branding: ; draw_branding (41AAH)
        LD A,055H
        LD (VAR_FILL),A
        LD A,011H
        LD (VAR_TEXT),A
        LD A,05H
        LD (VAR_X),A
        LD A,02EH
        LD (VAR_W),A
        LD A,07H
        LD (VAR_CURY),A
        LD A,011H
        LD (VAR_ROWS_LEFT),A
        LD HL,brand_sony
        LD (VAR_LABEL_PTR),HL
        CALL draw_bitmap_rows
        LD A,0CDH
        LD (VAR_X),A
        LD A,02EH
        LD (VAR_W),A
        LD A,07H
        LD (VAR_CURY),A
        LD A,012H
        LD (VAR_ROWS_LEFT),A
        LD HL,brand_hitbit
        LD (VAR_LABEL_PTR),HL
        CALL draw_bitmap_rows
        RET
draw_bitmap_rows: ; draw_bitmap_rows (41EFH)
bitmap_row: ; bitmap_row (41EFH)
        LD A,(VAR_CURY)
        LD H,A
        LD A,(VAR_X)
        LD L,A
        CALL vdp_set_write
        LD HL,(VAR_LABEL_PTR)
        LD A,(VAR_W)
        LD B,A
bitmap_byte: ; bitmap_byte (4201H)
        LD A,(HL)
        INC HL
        OR A
        JR Z,bitmap_fill
        CP 03H
        JR Z,bitmap_text
        CP 02H
        JR Z,bitmap_text_left
        LD A,(VAR_FILL)
        AND 0F0H
        LD C,A
        LD A,(VAR_TEXT)
        AND 0FH
        OR C
        JR bitmap_out
bitmap_text_left: ; bitmap_text_left (421CH)
        LD A,(VAR_TEXT)
        AND 0F0H
        LD C,A
        LD A,(VAR_FILL)
        AND 0FH
        OR C
        JR bitmap_out
bitmap_text: ; bitmap_text (422AH)
        LD A,(VAR_TEXT)
        JR bitmap_out
bitmap_fill: ; bitmap_fill (422FH)
        LD A,(VAR_FILL)
bitmap_out: ; bitmap_out (4232H)
        OUT (098H),A
        DJNZ bitmap_byte
        LD (VAR_LABEL_PTR),HL
        LD A,(VAR_CURY)
        INC A
        LD (VAR_CURY),A
        LD A,(VAR_ROWS_LEFT)
        DEC A
        LD (VAR_ROWS_LEFT),A
        JR NZ,bitmap_row
        RET
draw_rect: ; draw_rect (424AH)
        LD A,(VAR_Y)
        LD (VAR_CURY),A
        LD A,(VAR_H)
        LD (VAR_ROWS_LEFT),A
rect_row_loop: ; rect_row_loop (4256H)
        LD A,(VAR_CURY)
        LD H,A
        LD A,(VAR_X)
        LD L,A
        CALL vdp_set_write
        LD A,(VAR_ROWS_LEFT)
        LD B,A
        LD A,(VAR_H)
        CP B
        JR Z,rect_border_row
        LD A,B
        CP 01H
        JR Z,rect_border_row
        LD A,(VAR_BORDER)
        OUT (098H),A
        LD A,(VAR_W)
        SUB 02H
        LD B,A
        LD A,(VAR_FILL)
rect_fill_loop: ; rect_fill_loop (427EH)
        OUT (098H),A
        DJNZ rect_fill_loop
        LD A,(VAR_BORDER)
        OUT (098H),A
        JR rect_next_row
rect_border_row: ; rect_border_row (4289H)
        LD A,(VAR_W)
        LD B,A
        LD A,(VAR_BORDER)
rect_border_loop: ; rect_border_loop (4290H)
        OUT (098H),A
        DJNZ rect_border_loop
rect_next_row: ; rect_next_row (4294H)
        LD A,(VAR_CURY)
        INC A
        LD (VAR_CURY),A
        LD A,(VAR_ROWS_LEFT)
        DEC A
        LD (VAR_ROWS_LEFT),A
        JP NZ,rect_row_loop
        RET
draw_label: ; draw_label (42A6H)
        LD HL,(VAR_LABEL)
        LD (VAR_LABEL_PTR),HL
        LD A,(VAR_LEN)
        LD (VAR_LABEL_LEFT),A
label_loop: ; label_loop (42B2H)
        LD A,(VAR_LABEL_LEFT)
        OR A
        RET Z
        LD HL,(VAR_LABEL_PTR)
        LD A,(HL)
        INC HL
        LD B,A
        LD A,(VAR_TX)
        ADD A,B
        LD (VAR_PIX_X),A
        LD A,(HL)
        INC HL
        LD B,A
        LD (VAR_LABEL_PTR),HL
        LD A,(VAR_TY)
        ADD A,B
        LD (VAR_PIX_Y),A
        CALL draw_2x2
        LD A,(VAR_LABEL_LEFT)
        SUB 02H
        LD (VAR_LABEL_LEFT),A
        JR label_loop
draw_2x2: ; draw_2x2 (42DEH)
        LD A,(VAR_PIX_Y)
        LD H,A
        LD A,(VAR_PIX_X)
        LD L,A
        CALL vdp_set_write
        LD A,(VAR_TEXT)
        OUT (098H),A
        LD A,(VAR_PIX_Y)
        INC A
        LD H,A
        LD A,(VAR_PIX_X)
        LD L,A
        CALL vdp_set_write
        LD A,(VAR_TEXT)
        OUT (098H),A
        RET
vdp_set_write: ; vdp_set_write (4300H)
        DI
        LD A,H
        SRL A
        SRL A
        SRL A
        SRL A
        SRL A
        SRL A
        AND 03H
        OUT (099H),A
        NOP
        NOP
        NOP
        NOP
        LD A,08EH
        OUT (099H),A
        NOP
        NOP
        NOP
        NOP
        LD A,L
        OUT (099H),A
        NOP
        NOP
        NOP
        NOP
        LD A,H
        AND 03FH
        OR 040H
        OUT (099H),A
        NOP
        NOP
        NOP
        NOP
        RET
init_screen7: ; init_screen7 (4331H)
        DI
        LD A,0AH
        OUT (099H),A
        LD A,080H
        OUT (099H),A
        LD A,060H
        OUT (099H),A
        LD A,081H
        OUT (099H),A
        LD A,01FH
        OUT (099H),A
        LD A,082H
        OUT (099H),A
        LD A,0AH
        OUT (099H),A
        LD A,088H
        OUT (099H),A
        LD A,080H
        OUT (099H),A
        LD A,089H
        OUT (099H),A
        LD A,00H
        OUT (099H),A
        LD A,08EH
        OUT (099H),A
        LD A,07H
        LD (SCRMOD),A
        EI
        RET
clear_screen7: ; clear_screen7 (4369H)
        XOR A
        LD (VAR_CURY),A
clear_row: ; clear_row (436DH)
        LD A,(VAR_CURY)
        LD H,A
        LD L,00H
        CALL vdp_set_write
        LD B,00H
        LD A,055H
clear_byte: ; clear_byte (437AH)
        OUT (098H),A
        DJNZ clear_byte
        LD A,(VAR_CURY)
        INC A
        LD (VAR_CURY),A
        CP 0D4H
        JR NZ,clear_row
        RET
init_palette: ; init_palette (438AH)
        DI
        XOR A
        OUT (099H),A
        LD A,090H
        OUT (099H),A
        LD HL,palette_data
        LD B,010H
palette_loop: ; palette_loop (4397H)
        LD A,(HL)
        OUT (09AH),A
        INC HL
        LD A,(HL)
        OUT (09AH),A
        INC HL
        DJNZ palette_loop
        EI
        RET
palette_data: ; palette_data (43A3H)
        DB 00H,00H,011H,01H,022H,02H,033H,03H,044H,04H,055H,05H,066H,06H,077H,07H
        DB 00H,00H,011H,01H,022H,02H,033H,03H,044H,04H,055H,05H,066H,06H,077H,07H
        REPT 15421
        DB 0FFH
        ENDM
key_entries: ; key_entries (8000H)
        DB 06H,020H,01H,05H,020H,013H,0FH,023H,0AH,09H
        DW key_next_0
        DW key_variant_0_0
        DW key_variant_0_0
        DW key_variant_0_0
        DW key_variant_0_0
key_variant_0_0: ; key_variant_0_0 (8014H)
        DB 03H,03H,03H,02H,00H,00H,01H,00H,00H,02H,00H,00H,00H,00H,00H,03H
        DB 00H,00H,02H,00H,00H,00H,00H,01H,01H,00H,00H,03H,03H,03H,00H,00H
        DB 00H,01H,00H,00H,02H,00H,00H,00H,00H,00H,01H,00H,00H,02H,00H,00H
        DB 00H,00H,00H,01H,00H,00H,02H,00H,00H,00H,00H,00H,01H,00H,00H,00H
        DB 00H,00H,00H,00H,00H,00H,00H,00H
key_next_0: ; key_next_0 (805CH)
        DB 06H,040H,01H,01AH,020H,013H,0FH,023H,01FH,09H
        DW key_next_1
        DW key_variant_1_0
        DW key_variant_1_0
        DW key_variant_1_0
        DW key_variant_1_0
key_variant_1_0: ; key_variant_1_0 (8070H)
        DB 03H,03H,03H,02H,00H,03H,03H,03H,00H,02H,00H,00H,00H,00H,00H,00H
        DB 00H,02H,02H,00H,00H,00H,00H,00H,00H,00H,02H,03H,03H,03H,00H,00H
        DB 01H,03H,03H,00H,02H,00H,00H,00H,00H,02H,00H,00H,00H,02H,00H,00H
        DB 00H,00H,02H,00H,00H,00H,02H,00H,00H,00H,00H,03H,03H,03H,02H,00H
        DB 00H,00H,00H,00H,00H,00H,00H,00H
key_next_1: ; key_next_1 (80B8H)
        DB 06H,080H,01H,02FH,020H,013H,0FH,023H,034H,09H
        DW key_next_2
        DW key_variant_2_0
        DW key_variant_2_0
        DW key_variant_2_0
        DW key_variant_2_0
key_variant_2_0: ; key_variant_2_0 (80CCH)
        DB 03H,03H,03H,02H,00H,03H,03H,03H,00H,02H,00H,00H,00H,00H,00H,00H
        DB 00H,02H,02H,00H,00H,00H,00H,00H,00H,00H,02H,03H,03H,03H,00H,00H
        DB 01H,03H,03H,00H,02H,00H,00H,00H,00H,00H,00H,00H,02H,02H,00H,00H
        DB 00H,00H,00H,00H,00H,02H,02H,00H,00H,00H,00H,03H,03H,03H,00H,00H
        DB 00H,00H,00H,00H,00H,00H,00H,00H
key_next_2: ; key_next_2 (8114H)
        DB 07H,01H,01H,044H,020H,013H,0FH,023H,049H,09H
        DW key_next_3
        DW key_variant_3_0
        DW key_variant_3_0
        DW key_variant_3_0
        DW key_variant_3_0
key_variant_3_0: ; key_variant_3_0 (8128H)
        DB 03H,03H,03H,02H,00H,02H,00H,00H,02H,02H,00H,00H,00H,00H,02H,00H
        DB 00H,02H,02H,00H,00H,00H,00H,02H,00H,00H,02H,03H,03H,03H,00H,00H
        DB 03H,03H,03H,02H,02H,00H,00H,00H,00H,00H,00H,00H,02H,02H,00H,00H
        DB 00H,00H,00H,00H,00H,02H,02H,00H,00H,00H,00H,00H,00H,00H,02H,00H
        DB 00H,00H,00H,00H,00H,00H,00H,00H
key_next_3: ; key_next_3 (8170H)
        DB 07H,02H,01H,059H,020H,013H,0FH,023H,05EH,09H
        DW key_next_4
        DW key_variant_4_0
        DW key_variant_4_0
        DW key_variant_4_0
        DW key_variant_4_0
key_variant_4_0: ; key_variant_4_0 (8184H)
        DB 03H,03H,03H,02H,00H,03H,03H,03H,02H,02H,00H,00H,00H,00H,02H,00H
        DB 00H,00H,02H,00H,00H,00H,00H,02H,00H,00H,00H,03H,03H,03H,00H,00H
        DB 03H,03H,03H,00H,02H,00H,00H,00H,00H,00H,00H,00H,02H,02H,00H,00H
        DB 00H,00H,00H,00H,00H,02H,02H,00H,00H,00H,00H,03H,03H,03H,00H,00H
        DB 00H,00H,00H,00H,00H,00H,00H,00H
key_next_4: ; key_next_4 (81CCH)
        DB 08H,02H,01H,070H,020H,01AH,0FH,023H,073H,013H
        DW key_next_5
        DW key_variant_5_0
        DW key_variant_5_0
        DW key_variant_5_0
        DW key_variant_5_0
key_variant_5_0: ; key_variant_5_0 (81E0H)
        DB 02H,00H,00H,02H,00H,01H,03H,03H,00H,00H,02H,00H,00H,02H,00H,03H
        DB 03H,03H,02H,02H,00H,00H,02H,00H,02H,00H,00H,02H,00H,03H,00H,01H
        DB 02H,00H,02H,00H,00H,00H,02H,00H,00H,02H,00H,02H,00H,00H,02H,00H
        DB 02H,02H,02H,02H,00H,02H,00H,00H,00H,03H,03H,03H,02H,00H,02H,00H
        DB 00H,02H,00H,02H,01H,00H,02H,00H,03H,03H,03H,00H,02H,00H,00H,02H
        DB 00H,02H,00H,00H,02H,00H,02H,00H,00H,02H,00H,02H,00H,00H,00H,02H
        DB 00H,00H,02H,00H,02H,00H,00H,02H,00H,02H,00H,00H,02H,00H,02H,00H
        DB 00H,00H,02H,00H,00H,02H,00H,01H,03H,03H,00H,00H,02H,00H,00H,02H
        DB 00H,03H,03H,03H,02H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H
        DB 00H,00H,00H,00H,00H,00H,00H,00H
key_next_5: ; key_next_5 (8278H)
        DB 08H,04H,01H,08CH,020H,013H,0FH,023H,08EH,0EH
        DW key_next_6
        DW key_variant_6_0
        DW key_variant_6_0
        DW key_variant_6_0
        DW key_variant_6_0
